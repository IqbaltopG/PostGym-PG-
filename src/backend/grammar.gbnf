root ::= "{" ws "\"date\"" ws ":" ws string "," ws "\"sessions\"" ws ":" ws "[" ws sessions-list "]" ws "," ws "\"session_note\"" ws ":" ws (string | "null") ws "}"

sessions-list ::= session ("," ws session)*
session ::= "{" ws "\"muscle_group\"" ws ":" ws string "," ws "\"exercises\"" ws ":" ws "[" ws exercises-list "]" ws "}"

exercises-list ::= exercise ("," ws exercise)*
exercise ::= "{" ws "\"name\"" ws ":" ws string "," ws "\"canonical\"" ws ":" ws string "," ws "\"sets\"" ws ":" ws "[" ws sets-list "]" ws "}"

sets-list ::= set ("," ws set)*
set ::= "{" ws "\"weight_kg\"" ws ":" ws number "," ws "\"reps\"" ws ":" ws number "," ws "\"rpe\"" ws ":" ws (number | "null") "," ws "\"note\"" ws ":" ws (string | "null") ("," ws "\"per_hand\"" ws ":" ws boolean)? ws "}"

string ::= "\"" [a-zA-Z0-9_\- \(\)]+ "\""
number ::= [0-9]+ ("." [0-9]+)?
boolean ::= "true" | "false"
ws ::= [ \t\n]*
